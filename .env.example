# Banco PostgreSQL. Em produção, use SSL quando exigido pelo provedor.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/campo_comprido

# Acesso ao painel administrativo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_SESSION_SECRET=gere-um-segredo-longo-e-aleatorio

# Porta local opcional.
PORT=3000

# Integrações opcionais herdadas da plataforma original.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

